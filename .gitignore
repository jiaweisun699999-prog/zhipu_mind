# Virtual environment (各种常见命名)
.venv/
venv/
env/

# IDE / 编辑器配置
.idea/
.vscode/
*.swp
*.swo

# MCP config contains absolute paths, don't commit
.claude/settings.json

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# --- 敏感数据与日志配置 ---

# 环境变量及密钥 (绝对不要上传)
.env
.env.*
!.env.example

# 服务端聊天日志与临时文件
logs/
*.log
web.log
cpolar.log

# 本地 SQLite 数据库 (包含用户隐私、账户、密码及邀请码，不可上传)
data/*.db
data/app.db
data/chat.db
data/core.db

# 打包大模型文件与本地提取目录
fast-bge-small-zh-v1.5.tar.gz
models/

# 生成的 TTS 临时语音缓存与本地测试音频
app/static/audio/*
!app/static/audio/.gitkeep
*.mp3

