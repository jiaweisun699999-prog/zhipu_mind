# 生产环境部署时，请复制此文件并重命名为 .env
# 并将所有占位符替换为真实值

# ── DeepSeek API ──────────────────────────────────────────
OLLAMA_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-api-key-here
LLM_MODEL_NAME=deepseek-v4-pro

# ── JWT 安全密钥（生产环境必须替换！）─────────────────────
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
JWT_EXPIRE_MINUTES=10080

# ── 管理员密钥（创建/查看邀请码接口使用）────────────────────
# 生成方式：openssl rand -hex 16
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

# ── 安全与跨域配置 ──────────────────────────────────────────
# CORS 允许的域名，使用逗号分隔。如果是部署到生产，务必设置为真实域名。
CORS_ORIGINS=https://yourdomain.com,http://localhost:5173
